{
  "name": "moo3dstudio",
  "version": "0.0.2",
  "productName": "MOO3D Farm",
  "description": "MOO3D Farm desktop app for 3D printing pricing, orders, and inventory",
  "main": "main.js",
  "author": "Ms-Studio-3d",
  "license": "MIT",
  "keywords": [
    "electron",
    "3d-printing",
    "business-manager",
    "desktop-app",
    "inventory",
    "sqlite"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "rebuild": "electron-builder install-app-deps",
    "build": "electron-builder --dir",
    "dist": "electron-builder --win nsis --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:installer": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "test": "node tests/pricing.test.js && node tests/syntax.test.js && node tests/database.test.js && node tests/inventory.test.js && node tests/performance.test.js && node tests/ui.test.js && node tests/integration.test.js && node tests/concurrent-load.test.js && node tests/stability.test.js && node tests/pricing-preservation.test.js && node tests/review-regressions.test.js",
    "test:stability": "node tests/stability.test.js",
    "setup:electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "better-sqlite3": "13.0.3",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.msstudio3d.moo3dstudio",
    "asar": true,
    "artifactName": "${productName}-${version}-${target}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "database.js",
      "backup-worker.js",
      "backup-safety.js",
      "reset-options.js",
      "tracking-workbook.js",
      "assets/tracking-template.xlsx",
      "index.html",
      "style.css",
      "package.json",
      "js/**/*",
      "node_modules/**/*",
      "!**/.git/**/*",
      "!**/.github/**/*",
      "!**/.cache/**/*",
      "!**/dist/**/*",
      "!**/build-installer.yml",
      "!**/*.md",
      "!**/*.map",
      "!**/*.log",
      "!**/test/**/*",
      "!**/tests/**/*",
      "!**/docs/**/*",
      "!**/coverage/**/*",
      "!**/.vscode/**/*",
      "!**/.idea/**/*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": "Ms-Studio-3d"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "MOO3D Farm",
      "uninstallDisplayName": "MOO3D Farm",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/**/*.node"
    ],
    "npmRebuild": false
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
